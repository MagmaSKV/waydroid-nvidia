From 0000000000000000000000000000000000000002 Mon Sep 17 00:00:00 2001
From: waydroid-nvidia
Date: Sun, 18 Oct 2026 21:09:00 +0800
Subject: [PATCH] waydroid: skip the AppArmor profile key when liblxc lacks AppArmor

config_3 ships `lxc.apparmor.profile = unconfined`. Fedora/RHEL (and some other
SELinux distros) ship liblxc built without HAVE_APPARMOR, and their parser returns
EINVAL for that key, so lxc-start refuses to load the whole config (waydroid#1495,
waydroid-nvidia#6). Detect the capability with ldd and strip every AppArmor key
when it is absent; where it is present the previous behaviour is kept.
---
 tools/helpers/lxc.py | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/tools/helpers/lxc.py b/tools/helpers/lxc.py
--- a/tools/helpers/lxc.py
+++ b/tools/helpers/lxc.py
@@ -213,6 +213,30 @@
     return nodes
 
 LXC_APPARMOR_PROFILE = "lxc-waydroid"
+
+def lxc_supports_apparmor():
+    """True iff liblxc was built with AppArmor.
+
+    Fedora/RHEL (and some other SELinux distros) ship liblxc without AppArmor. Their parser returns
+    EINVAL for `lxc.apparmor.profile`, so leaving the stock `unconfined` line in the generated
+    config makes `lxc-start` refuse to load it (waydroid#1495, waydroid-nvidia#6). Kernel AppArmor
+    being enabled is irrelevant: the key itself is invalid without HAVE_APPARMOR.
+    """
+    for lib in (
+        "/usr/lib64/liblxc.so.1",
+        "/usr/lib/liblxc.so.1",
+        "/usr/lib/x86_64-linux-gnu/liblxc.so.1",
+        "/usr/lib/aarch64-linux-gnu/liblxc.so.1",
+    ):
+        if not os.path.exists(lib):
+            continue
+        try:
+            out = subprocess.check_output(["ldd", lib], text=True, stderr=subprocess.DEVNULL)
+            return "libapparmor.so" in out
+        except (OSError, subprocess.CalledProcessError):
+            return False
+    return False
+
 def get_apparmor_status(args):
     enabled = False
     if shutil.which("aa-enabled"):
@@ -255,7 +279,12 @@
     tools.helpers.run.user(args, command)
     command = ["cp", "-fpr", seccomp_profile, lxc_path + "/waydroid.seccomp"]
     tools.helpers.run.user(args, command)
-    if get_apparmor_status(args):
+    if not lxc_supports_apparmor():
+        # config_3 ships `lxc.apparmor.profile = unconfined`. Strip every AppArmor key so a liblxc
+        # built without HAVE_APPARMOR can parse the file.
+        command = ["sed", "-i", "-E", "/lxc\\.aa_profile|lxc\\.apparmor\\./d", lxc_path + "/config"]
+        tools.helpers.run.user(args, command)
+    elif get_apparmor_status(args):
         command = ["sed", "-i", "-E", "/lxc.aa_profile|lxc.apparmor.profile/ s/unconfined/{}/g".format(LXC_APPARMOR_PROFILE), lxc_path + "/config"]
         tools.helpers.run.user(args, command)
 
